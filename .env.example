# Vite exposes every VITE_* value to the client bundle. Never put service-role
# keys or Cloudflare Worker secrets in this file.
VITE_GOOGLE_CLIENT_ID=
VITE_PLUNO_WHATSAPP=
VITE_PUBLIC_APP_URL=https://internal.plunostudio.com
VITE_SOCIAL_API_URL=https://pluno-social-inbox.<your-subdomain>.workers.dev
